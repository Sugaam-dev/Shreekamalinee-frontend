# ==============================================================================
# SHREEKAMALINEE FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Backend Spring Boot API URL (No trailing slash)
# Local Development: http://localhost:8090
# Production: https://api.yourdomain.com (or https://your-backend.onrender.com)
VITE_API_URL=http://localhost:8090

# 2. Google OAuth 2.0 Web Client ID (Public identifier for Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
